# 复制为 .env 后按需填写；.env 已被 .gitignore 忽略，请勿提交。
# 版本号 / 数据库路径 / LLM 配置；模型密钥只在后端使用。

APP_VERSION=0.4.0-stage3
API_VERSION=v1
MIN_SHELL_VERSION=0.1.0
TIMEZONE=Asia/Shanghai

# SQLite 数据库路径（相对 backend/ 目录，也可写绝对路径）
DB_PATH=data/eldercare.db

# DeepSeek（OpenAI 兼容接口）。阶段 2 起用于真实对话；留空时对话接口返回 503。
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_API_KEY=

# 开发期跨域来源，逗号分隔；线上同域部署时无需配置
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
